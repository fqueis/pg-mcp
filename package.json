{
  "name": "@fqueis/pg-mcp",
  "version": "0.3.1",
  "description": "Global MCP server for PostgreSQL: agents register connections on demand and query them read-only by default",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pg-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tsx scripts/copy-sql.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint \"{src,tests,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,tests,scripts}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "postgres",
    "postgresql",
    "database"
  ],
  "author": "fqueis",
  "license": "MIT",
  "homepage": "https://github.com/fqueis/pg-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fqueis/pg-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fqueis/pg-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "18.0.10",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "5.0.1"
  }
}
